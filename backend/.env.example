# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=social_media
POSTGRES_USER=muhammadrafay
POSTGRES_PASSWORD=social_media
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT / tokens
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_SLIDING_DAYS=30
REFRESH_ABSOLUTE_DAYS=90

# Refresh cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=False          # True in production (HTTPS only)
REFRESH_COOKIE_SAMESITE=Lax          # Lax for same-site dev; None (with Secure) if truly cross-site

# CORS / frontend
FRONTEND_ORIGIN=http://localhost:5173
